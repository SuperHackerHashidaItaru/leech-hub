# local test only - the real values live in the repo's GitHub secrets:
#   Settings -> Secrets and variables -> Actions
# HUB_URL        https://<your-hub>.vercel.app
# LEECH_TOKEN    the hub's TOKEN (same one the bot sends as x-leech-token)
# PIXELDRAIN_KEY optional but recommended - free account key from
#                pixeldrain.com/api - puts pixeldrain (20GB, long-lived)
#                first in the upload chain. without it: x0 -> uguu ->
#                litterbox (1GB/128MB/1GB caps, 3-72h retention).
HUB_URL=
TOKEN=
PIXELDRAIN_KEY=

# optional upload chain tuning (repo variables or env)
# UPLOAD_BACKEND=auto
# UPLOAD_FALLBACKS=x0,uguu,litterbox
