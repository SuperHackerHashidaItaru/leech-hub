# leech hub env - set these in vercel (project settings -> env vars)
# everything is one shared secret, same style as the old leech-server.

# shared secret. the bot AND the github runner send it as x-leech-token.
# generate: python -c "import secrets; print(secrets.token_urlsafe(24))"
TOKEN=

# upstash redis database #2 - a NEW one, not the tts/jobs one.
# free tier: github login, no card. copy the REST url + token from its
# dashboard ("REST API" section).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# the monochrome api this hub wraps (swap = instant provider migration
# without touching the bot or the runner)
MONO_BASE=https://tracks.monochrome.st

# lyrics provider (lrclib - free, open, no key; we identify via UA)
LRCLIB_BASE=https://lrclib.net

# the runner repo. create it PUBLIC (free unlimited actions minutes) and
# push the runner/ folder from this zip.
GITHUB_REPO=yourname/leech-runner

# fine-grained PAT: repository access = ONLY leech-runner,
# permissions -> contents: read and write. (repository_dispatch needs it)
GITHUB_PAT=
